# Salin file ini menjadi ".env.local" lalu isi dengan kredensial project Supabase Anda
# (Project Settings -> API di dashboard Supabase).

# Aman dipakai di browser (public key, dibatasi oleh Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RAHASIA — jangan pernah expose ke client/browser.
# Hanya dipakai di API routes (src/lib/supabase/admin.ts) untuk operasi
# yang butuh bypass Row Level Security (mis. proses generate image).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain produksi asli (dipakai sitemap.xml, robots.txt, OG meta tags).
# Saat dev boleh dikosongkan (fallback ke http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
